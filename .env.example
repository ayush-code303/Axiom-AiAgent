# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Blockchain Configuration (Sepolia Testnet)
# Leave empty or remove if blockchain features are not needed
# BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# BLOCKCHAIN_PRIVATE_KEY=your_wallet_private_key_without_0x
# BLOCKCHAIN_CONTRACT_ADDRESS=0x...
# BLOCKCHAIN_CONTRACT_ABI=[{"inputs":[],"name":"storeProof","outputs":[],"stateMutability":"nonpayable","type":"function"}]
